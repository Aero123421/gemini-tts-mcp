# === Required ===
BASE_URL=https://gemini-tts-mcp-xxxxx-an.a.run.app
GEMINI_API_KEY=AIza...
GOOGLE_OAUTH_CLIENT_ID=1234567890-xxxx.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=GOCSPX-...
ALLOWED_EMAILS=you@gmail.com
# true admits every verified Google account, bypassing ALLOWED_EMAILS.
# All users share one project's custom voices and monthly usage totals.
ALLOW_ANY_USER=false

# Stable secrets (store in Secret Manager on Cloud Run!)
# JWT_SIGNING_KEY:        openssl rand -hex 32
# STORAGE_ENCRYPTION_KEY: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
JWT_SIGNING_KEY=replace-with-64-char-hex-secret
STORAGE_ENCRYPTION_KEY=replace-with-fernet-base64-key

# === Firestore (required on Cloud Run for OAuth token & monthly usage persistence) ===
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
FIRESTORE_DATABASE=(default)
FIRESTORE_COLLECTION_PREFIX=gemini-tts-mcp

# === Optional: Gemini Enterprise static OAuth client support (MultiAuth) ===
# GEMINI_ENTERPRISE_CLIENT_ID=

# === Optional: Rate limits (per user, sliding window) ===
RATE_WARN_PER_MIN=10
RATE_BLOCK_PER_MIN=30
RATE_WARN_PER_HOUR=60
RATE_BLOCK_PER_HOUR=120

# === Optional: Input & Job guardrails ===
MAX_CHARS_PER_SEGMENT=4000
MAX_TOTAL_CHARS=20000
MAX_SEGMENTS=20
TTS_CONCURRENCY=4
TTS_TIMEOUT_SEC=60
SYNC_WAIT_SEC=25
POLL_WAIT_SEC=25
MAX_ACTIVE_JOBS=4
MAX_CACHED_JOBS=20
MAX_CACHE_BYTES=268435456
JOB_TTL_SEC=900
MONTHLY_BUDGET_USD=100.0
# Interactions API requests use store=False. ZIP manifest.json includes the full script.
# In-memory download links expire on Cloud Run deployment, restart, or scale-to-zero.
# Spend cap enforcement can lag. Source deploys also incur Cloud Build / Artifact Registry costs.
# Estimated studio input USD per million tokens: 0.50 in 2026, 1.00 from 2027 (UTC).
# Grant roles/secretmanager.secretAccessor separately on each of the four deployment secrets.
